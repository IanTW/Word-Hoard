{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "F:\\Programming\\Python\\word-hoard\\.claude\\hooks\\no_dashes_response.ps1"
            ],
            "timeout": 10,
            "statusMessage": "Checking the reply for em and en dashes"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "F:\\Programming\\Python\\word-hoard\\.claude\\hooks\\no_dashes_file.ps1"
            ],
            "timeout": 10,
            "statusMessage": "Checking the written text for em and en dashes"
          }
        ]
      }
    ]
  }
}
